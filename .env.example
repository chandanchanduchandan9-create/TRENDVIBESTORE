# =================================================================
# TrendVibe AI Shopping Sales Agent - Environment Configuration
# Bolna AI Telephony Integration for Real Indian Mobile Numbers (+91)
# =================================================================

PORT=3000
NODE_ENV=development
SERVER_BASE_URL=http://localhost:3000
DEFAULT_COUNTRY_CODE=+91

# Google Gemini API (Product analysis and intelligence)
GEMINI_API_KEY=your_gemini_api_key_here

# Bolna AI Telephony & Voice Agent (https://www.bolna.ai)
# 1. Obtain your API Key from Bolna Studio -> API Keys
BOLNA_API_KEY=your_bolna_api_key_here
# 2. Obtain your Agent ID (UUID) from Bolna Studio -> Agent Settings
BOLNA_AGENT_ID=your_bolna_agent_id_uuid_here
# 3. Optional: Dedicated Outbound Caller ID / Telephony Number attached to Bolna (e.g. +9180XXXXXXXX)
# Leave blank to use Bolna's default registered number
BOLNA_FROM_PHONE_NUMBER=
# 4. Bolna API Base URL
BOLNA_BASE_URL=https://api.bolna.ai

# Database - MongoDB (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/trendvibe
MONGODB_DB_NAME=trendvibe

# n8n Automation Webhooks (Optional)
N8N_LEAD_WEBHOOK_URL=http://localhost:5678/webhook/lead-intake
N8N_POST_CALL_WEBHOOK_URL=http://localhost:5678/webhook/post-call

# Google Sheets CRM (Optional Service Account)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Internal Security
WEBHOOK_SECRET=trendvibe_dev_secret_2026
